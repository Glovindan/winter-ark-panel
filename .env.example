# Токен бота из @BotFather (нужен для проверки initData и для бота)
BOT_TOKEN=
# Бот и вечерняя рассылка запускаются только при BOT_ENABLED=1.
# Держи 1 только в одном месте: два процесса с одним токеном будут мешать друг другу.
BOT_ENABLED=0
# HTTPS-адрес Mini App (для кнопки «Открыть панель»). Для разработки подойдёт адрес туннеля.
WEBAPP_URL=
# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me
# tg_id администратора: входит без приглашения и получает /invite
ADMIN_TG_ID=
PORT=3000
DB_PATH=./data/ark.db
# Только для локальной разработки без Telegram: разрешает POST /auth с {dev:{id,name}}
DEV_AUTH=0
# Подмена «сегодня» (YYYY-MM-DD), работает только при DEV_AUTH=1
DEV_TODAY=
BOT_ENABLED=1